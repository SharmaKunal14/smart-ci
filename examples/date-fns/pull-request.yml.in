name: Smart CI / date-fns evaluation
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
permissions:
  contents: read
concurrency:
  group: smartci-date-fns-${{ github.event.pull_request.number }}
  cancel-in-progress: true
jobs:
  core-node-utc:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          path: app
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '26.13.1'
      - name: Install pinned package manager and native dependencies
        run: |
          npm install --prefix "$RUNNER_TEMP/package-manager" pnpm@12.21.0
          node "$RUNNER_TEMP/package-manager/node_modules/pnpm/bin/pnpm.mjs" \
            --dir app install --frozen-lockfile \
            --store-dir "$RUNNER_TEMP/pnpm-store" --cache-dir "$RUNNER_TEMP/pnpm-cache"
      # This independent control remains authoritative throughout evaluation.
      - name: Unfiltered native core/main baseline
        id: native
        continue-on-error: true
        working-directory: app/pkgs/core
        env:
          TZ: UTC
        run: |
          node ../../node_modules/vitest/vitest.mjs run --project main \
            --reporter=json --outputFile="$RUNNER_TEMP/native-full.json"
      - name: Unchanged native timezone regression scripts
        id: timezone
        continue-on-error: true
        working-directory: app/pkgs/core
        run: bash scripts/test/tz.sh
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        id: control
        continue-on-error: true
        with:
          repository: TOOL_REPOSITORY
          ref: TOOL_COMMIT
          path: control
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        id: python
        continue-on-error: true
        with:
          python-version: '3.14'
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9
        id: uv
        continue-on-error: true
        with:
          version: '0.11.6'
          enable-cache: false
      - name: Install pinned Smart CI
        id: tool
        if: steps.control.outcome == 'success' && steps.python.outcome == 'success' && steps.uv.outcome == 'success'
        continue-on-error: true
        working-directory: control
        run: uv sync --frozen
      - name: Plan and execute with independent full fallback
        id: smartci
        continue-on-error: true
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          TOOL_READY: ${{ steps.tool.outcome }}
          FORCE_FULL: ${{ vars.SMARTCI_FORCE_FULL }}
          TZ: UTC
        shell: bash
        run: |
          set -uo pipefail
          status=2
          if [[ "$TOOL_READY" == 'success' && "$FORCE_FULL" != 'true' ]]; then
            control/.venv/bin/smartci typescript run \
              --repo "$GITHUB_WORKSPACE/app" \
              --config "$GITHUB_WORKSPACE/control/examples/date-fns/typescript.json" \
              --base "$BASE_SHA" --output "$RUNNER_TEMP/smartci-result" \
              --pnpm "$RUNNER_TEMP/package-manager/node_modules/pnpm/bin/pnpm.mjs" \
              --dependency-store "$RUNNER_TEMP/pnpm-store" --dependency-cache "$RUNNER_TEMP/pnpm-cache"
            status=$?
          fi
          if [[ "$status" -eq 0 || "$status" -eq 1 ]]; then exit "$status"; fi
          echo 'Smart CI unavailable or incomplete: running native full tests.'
          cd app/pkgs/core
          node ../../node_modules/vitest/vitest.mjs run --project main --allowOnly=false --passWithNoTests=false
      - name: Preserve every observed failure
        if: always()
        env:
          NATIVE: ${{ steps.native.outcome }}
          TIMEZONE: ${{ steps.timezone.outcome }}
          SMARTCI: ${{ steps.smartci.outcome }}
        run: test "$NATIVE" = success && test "$TIMEZONE" = success && test "$SMARTCI" = success
      - name: Upload bounded comparison artifacts
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: smartci-date-fns-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/native-full.json
            ${{ runner.temp }}/smartci-result/audit.md
            ${{ runner.temp }}/smartci-result/selection.json
            ${{ runner.temp }}/smartci-result/run.json
          if-no-files-found: ignore
          retention-days: 3
