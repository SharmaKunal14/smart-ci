{
  "$defs": {
    "RateCard": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "gpt-6.2-astra",
          "default": "gpt-6.2-astra",
          "title": "Model",
          "type": "string"
        },
        "input_micro_usd": {
          "const": 10,
          "default": 10,
          "title": "Input Micro Usd",
          "type": "integer"
        },
        "output_micro_usd": {
          "const": 40,
          "default": 40,
          "title": "Output Micro Usd",
          "type": "integer"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "source": {
          "const": "https://developers.openai.com/api/docs/pricing",
          "default": "https://developers.openai.com/api/docs/pricing",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "checked_at"
      ],
      "title": "RateCard",
      "type": "object"
    },
    "Reservation": {
      "additionalProperties": false,
      "properties": {
        "investigation": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Investigation",
          "type": "string"
        },
        "slot": {
          "exclusiveMaximum": 4,
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "request_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "input_limit": {
          "default": 5000,
          "maximum": 5000,
          "minimum": 1,
          "title": "Input Limit",
          "type": "integer"
        },
        "output_limit": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Output Limit",
          "type": "integer"
        },
        "micro_usd": {
          "minimum": 1,
          "title": "Micro Usd",
          "type": "integer"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "propertyNames": {
                "enum": [
                  "input_tokens",
                  "output_tokens"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        }
      },
      "required": [
        "investigation",
        "slot",
        "request_digest",
        "micro_usd"
      ],
      "title": "Reservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "smartci.model-budget.v1",
      "default": "smartci.model-budget.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "campaign": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Campaign",
      "type": "string"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "rates": {
      "$ref": "#/$defs/RateCard"
    },
    "cap_micro_usd": {
      "default": 5000000,
      "maximum": 5000000,
      "minimum": 1,
      "title": "Cap Micro Usd",
      "type": "integer"
    },
    "max_calls": {
      "default": 24,
      "maximum": 24,
      "minimum": 1,
      "title": "Max Calls",
      "type": "integer"
    },
    "max_investigations": {
      "default": 6,
      "maximum": 6,
      "minimum": 1,
      "title": "Max Investigations",
      "type": "integer"
    },
    "max_input_tokens": {
      "default": 120000,
      "maximum": 120000,
      "minimum": 1,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "default": 24000,
      "maximum": 24000,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "reservations": {
      "items": {
        "$ref": "#/$defs/Reservation"
      },
      "maxItems": 24,
      "title": "Reservations",
      "type": "array"
    }
  },
  "required": [
    "campaign",
    "rates"
  ],
  "title": "Campaign",
  "type": "object"
}
