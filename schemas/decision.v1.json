{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,199}$",
      "title": "Repository",
      "type": "string"
    },
    "mode": {
      "enum": [
        "full",
        "subset"
      ],
      "title": "Mode",
      "type": "string"
    },
    "selected": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,199}$",
        "type": "string"
      },
      "maxItems": 100000,
      "title": "Selected",
      "type": "array"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "policy_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "mode",
    "selected",
    "reasons",
    "policy_digest"
  ],
  "title": "Decision",
  "type": "object"
}
