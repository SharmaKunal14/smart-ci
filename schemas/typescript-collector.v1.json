{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,199}$",
      "title": "Repository",
      "type": "string"
    },
    "projects": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Projects",
      "type": "array"
    },
    "full_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Full Paths",
      "type": "array"
    },
    "must_run": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Must Run",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "projects"
  ],
  "title": "TypeScriptConfig",
  "type": "object"
}
