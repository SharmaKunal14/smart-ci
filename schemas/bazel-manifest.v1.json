{
  "$defs": {
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,199}$",
          "title": "Repository",
          "type": "string"
        },
        "bazel_version": {
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Bazel Version",
          "type": "string"
        },
        "command_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "options_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Options Digest",
          "type": "string"
        },
        "environment_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Environment Digest",
          "type": "string"
        },
        "query_mode": {
          "const": "unconfigured-deps-all",
          "title": "Query Mode",
          "type": "string"
        },
        "change_model": {
          "const": "reviewed-declared-cpp-inputs-v1",
          "title": "Change Model",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "bazel_version",
        "command_digest",
        "options_digest",
        "environment_digest",
        "query_mode",
        "change_model"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "collector": {
      "const": "bazel-native-bundle-v1",
      "default": "bazel-native-bundle-v1",
      "title": "Collector",
      "type": "string"
    },
    "anchor_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Anchor Commit",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "artifacts": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxProperties": 4,
      "minProperties": 4,
      "title": "Artifacts",
      "type": "object"
    },
    "capture_config_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Config Digest"
    }
  },
  "required": [
    "anchor_commit",
    "profile",
    "artifacts"
  ],
  "title": "Manifest",
  "type": "object"
}
